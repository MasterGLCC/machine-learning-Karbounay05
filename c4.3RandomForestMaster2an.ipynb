    }
   },
   "cell_type": "code",
   "source": [
    "def analyze_feature_importance(X: np.ndarray, y: np.ndarray, features: List[str]) -> Dict[str, float]:\n",
    "    \"\"\"Calculate feature importance using gain ratio.\"\"\"\n",
    "    importance = {}\n",
    "    h_s = entropy(y)\n",
    "    print(f\"\\n=== C4.5 FEATURE IMPORTANCE ANALYSIS ===\")\n",
    "    print(f\"Initial Entropy: {h_s:.4f}\\n\")\n",
    "    \n",
    "    for i in range(X.shape[1]):\n",
    "        threshold, ratio = find_best_threshold(X[:, i], y)\n",
    "        importance[features[i]] = ratio\n",
    "        print(f\"{features[i]:18} - Gain Ratio: {ratio:.4f} (threshold: {threshold})\")\n",
    "    \n",
    "    # Sort by importance\n",
    "    sorted_importance = sorted(importance.items(), key=lambda x: x[1], reverse=True)\n",
    "    print(f\"\\n>>> Top 3 Most Important Features:\")\n",
    "    for rank, (feature, score) in enumerate(sorted_importance[:3], 1):\n",
    "        print(f\"  {rank}. {feature:18} ({score:.4f})\")\n",
    "    \n",
    "    return importance\n",
    "\n",
    "importance_scores = analyze_feature_importance(X_m2, y_m2, all_modules_m2)"
   ],
   "id": "feature_analysis",
   "outputs": [],
   "execution_count": 5
  },
