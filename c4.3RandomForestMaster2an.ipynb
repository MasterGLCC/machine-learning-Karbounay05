   "cell_type": "code",
   "source": [
    "def print_tree(node: TreeNode, indent: str = \"\", is_left: bool = None) -> None:\n",
    "    \"\"\"Print tree structure in a readable format.\"\"\"\n",
    "    if node is None:\n",
    "        return\n",
    "    \n",
    "    if is_left is None:\n",
    "        print(f\"Root Node\")\n",
    "    else:\n",
    "        prefix = \"├─ \" if is_left else \"└─ \"\n",
    "        print(indent + prefix, end=\"\")\n",
    "    \n",
    "    if node.is_leaf():\n",
    "        labels_map = {1: \"✓ ADMIS\", 0: \"⟳ RATTRAPAGE\", -1: \"✗ ÉCHEC\"}\n",
    "        print(f\"[LEAF] {labels_map[node.value]} (samples: {node.samples})\")\n",
    "    else:\n",
    "        print(f\"[SPLIT] {node.feature_name} ≤ {node.threshold:.2f}? (samples: {node.samples})\")\n",
    "        next_indent = indent + (\"│  \" if is_left else \"   \")\n",
    "        print_tree(node.left, next_indent, True)\n",
    "        print_tree(node.right, next_indent, False)\n",
    "\n",
    "print(\"\\n\" + \"=\"*60)\n",
    "print(\"C4.5 DECISION TREE STRUCTURE\")\n",
    "print(\"=\"*60 + \"\\n\")\n",
    "print_tree(tree.root)"
   ],
   "id": "tree_structure",
   "outputs": [],
