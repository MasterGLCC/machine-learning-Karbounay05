   },
   "source": [
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "from collections import Counter\n",
    "import math\n",
    "from typing import Tuple, Optional, Dict, List\n",
    "\n",
    "# Set random seed for reproducibility\n",
    "np.random.seed(42)\n",
    "\n",
    "# --- CONFIGURATION DES MODULES M2 ---\n",
    "modules_s3 = [\"UML\", \"Oracle 2\", \"Math\", \"Deep Learning\", \"JupyterNotebook\", \"Soft Skills 2\"]\n",
    "modules_s4 = [\"Projet Tutorial 1\", \"Projet Tutorial 2\", \"Stage PFE 1\", \"Stage PFE 2\"]\n",
    "all_modules_m2 = modules_s3 + modules_s4\n",
    "\n",
    "# Dataset M2 : 100 étudiants, 10 modules (augmented for better learning)\n",
    "X_m2 = np.random.randint(5, 20, size=(100, 10))\n",
    "\n",
    "# Labels Master : 1 (Admis), 0 (Rattrapage), -1 (Échec)\n",
    "y_m2 = np.array([1 if np.mean(e) >= 12 else (0 if np.mean(e) >= 10 else -1) for e in X_m2])\n",
    "\n",
    "print(f\"Dataset shape: {X_m2.shape}\")\n",
    "print(f\"Class distribution: {dict(Counter(y_m2))}\")\n",
    "print(f\"Features: {all_modules_m2}\")"
   ],
   "outputs": [],
   "execution_count": 1
  },
  {
   "cell_type": "markdown",
   "id": "cell_functions",
   "metadata": {},
   "source": [
    "## 2. Core C4.5 Functions"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {
    "ExecuteTime": {
     "end_time": "2026-05-10T13:50:59.737075200Z",
     "start_time": "2026-05-10T13:50:59.636259300Z"
    }
   },
   "cell_type": "code",
   "source": [
    "def entropy(y: np.ndarray) -> float:\n    "\"\"\"Calculate Shannon entropy: H(S) = -Σ p_i * log2(p_i)\"\"\"\n",
    "    if len(y) == 0:\n",
    "        return 0\n",
    "    counts = Counter(y)\n",
    "    probs = [c / len(y) for c in counts.values()]\n",
    "    return -sum(p * math.log2(p) for p in probs if p > 0)\n",
    "\n",
    "\n",
    "def split_info(y_subsets: List[np.ndarray]) -> float:\n",
    "    \"\"\"Calculate intrinsic information of a split.\n",
    "    SplitInfo(S, A) = -Σ (|Si|/|S|) * log2(|Si|/|S|)\n",
    "    This measures the intrinsic information generated by the split.\n",
    "    \"\"\"\n",
    "    total = sum(len(s) for s in y_subsets)\n",
    "    if total == 0:\n",
    "        return 0\n",
    "    return -sum((len(s) / total) * math.log2(len(s) / total) for s in y_subsets if len(s) > 0)\n",
    "\n",
    "\n",
    "def find_best_threshold(X_col: np.ndarray, y: np.ndarray) -> Tuple[float, float]:\n",
    "    \"\"\"Find optimal threshold for continuous feature using exhaustive search.\n",
    "    Returns: (best_threshold, best_gain_ratio)\n",
    "    \"\"\"\n",
    "    best_threshold = None\n",
    "    best_ratio = 0\n",
    "    h_s = entropy(y)\n",
    "    \n",
    "    # Try all unique values as potential thresholds\n",
    "    unique_values = np.unique(X_col)\n",
    "    \n",
    "    for threshold in unique_values[:-1]:  # Exclude last value\n",
    "        mask = X_col <= threshold\n",
    "        groups = [y[mask], y[~mask]]\n",
    "        \n",
    "        if len(groups[0]) == 0 or len(groups[1]) == 0:\n",
    "            continue\n",
    "        \n",
    "        # Information gain\n",
    "        gain = h_s - sum((len(g) / len(y)) * entropy(g) for g in groups)\n",
    "        \n",
    "        # Split information (C4.5 normalization)\n",
    "        si = split_info(groups)\n",
    "        \n",
    "        # Gain ratio\n",
    "        ratio = gain / si if si > 0 else 0\n",
    "        \n",
    "        if ratio > best_ratio:\n",
    "            best_ratio = ratio\n",
    "            best_threshold = threshold\n",
    "    \n",
    "    return best_threshold, best_ratio\n",
    "\n",
    "\n",
    "def select_best_split(X: np.ndarray, y: np.ndarray, features: List[str]) -> Tuple[Optional[int], Optional[float], float]:\n",
    "    \"\"\"Select best feature and threshold for splitting.\n",
    "    Returns: (feature_index, threshold, gain_ratio)\n",
    "    \"\"\"\n",
    "    best_feature = None\n",
    "    best_threshold = None\n",
    "    best_ratio = 0\n",
    "    \n",
    "    h_s = entropy(y)\n",
    "    \n",
    "    for i in range(X.shape[1]):\n",
    "        threshold, ratio = find_best_threshold(X[:, i], y)\n",
    "        \n",
    "        if ratio > best_ratio:\n",
    "            best_ratio = ratio\n",
    "            best_feature = i\n",
    "            best_threshold = threshold\n",
    "    \n",
    "    return best_feature, best_threshold, best_ratio\n",
    "\n",
    "\n",
    "print(\"✓ Core C4.5 functions defined\")"
   ],
   "id": "6ac04972c7dd58c9",
