   "cell_type": "code",
   "source": [
    "# Train C4.5 tree\n",
    "tree = C45DecisionTree(max_depth=5, min_samples_split=5)\n",
    "tree.fit(X_m2, y_m2, feature_names=all_modules_m2)\n",
    "\n",
    "# Predictions\n",
    "y_pred = tree.predict(X_m2)\n",
    "accuracy = tree.score(X_m2, y_m2)\n",
    "\n",
    "print(f\"\\n=== C4.5 TREE PERFORMANCE ===\")\n",
    "print(f\"Training Accuracy: {accuracy:.4f}\")\n",
    "print(f\"\\nClass Distribution:\")\n",
    "for class_label in sorted(np.unique(y_m2)):\n",
    "    count_true = np.sum(y_m2 == class_label)\n",
    "    count_pred = np.sum(y_pred == class_label)\n",
    "    labels_map = {1: \"Admis\", 0: \"Rattrapage\", -1: \"Échec\"}\n",
    "    print(f\"  {labels_map[class_label]:12} - True: {count_true:3}, Predicted: {count_pred:3}\")"
   ],
