   "cell_type": "code",
   "source": [
    "def get_tree_statistics(node: TreeNode) -> Dict:\n",
    "    \"\"\"Calculate tree statistics.\"\"\"\n",
    "    def count_nodes(n):\n",
    "        if n is None:\n",
    "            return 0\n",
    "        return 1 + count_nodes(n.left) + count_nodes(n.right)\n",
    "    \n",
    "    def count_leaves(n):\n",
    "        if n is None:\n",
    "            return 0\n",
    "        if n.is_leaf():\n",
    "            return 1\n",
    "        return count_leaves(n.left) + count_leaves(n.right)\n",
    "    \n",
    "    def get_max_depth(n):\n",
    "        if n is None or n.is_leaf():\n",
    "            return 0\n",
    "        return 1 + max(get_max_depth(n.left), get_max_depth(n.right))\n",
    "    \n",
    "    return {\n",
    "        'total_nodes': count_nodes(node),\n",
    "        'leaf_nodes': count_leaves(node),\n",
    "        'internal_nodes': count_nodes(node) - count_leaves(node),\n",
    "        'max_depth': get_max_depth(node)\n",
    "    }\n",
    "\n",
    "stats = get_tree_statistics(tree.root)\n",
    "\n",
    "print(\"\\n\" + \"=\"*60)\n",
    "print(\"ENHANCED C4.5 TREE - SUMMARY REPORT\")\n",
    "print(\"=\"*60)\n",
    "print(f\"\\n📊 Tree Structure:\")\n",
