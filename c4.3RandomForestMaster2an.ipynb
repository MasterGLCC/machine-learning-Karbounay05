   },
   "cell_type": "code",
   "source": [
    "def visualize_tree_enhanced(tree_root: TreeNode, feature_names: List[str]):\n",
    "    \"\"\"Enhanced visualization of the C4.5 tree.\"\"\"\n",
    "    fig, ax = plt.subplots(figsize=(16, 10))\n",
    "    fig.patch.set_facecolor(\"#0A0A0A\")\n",
    "    ax.set_facecolor(\"#0A0A0A\")\n",
    "    ax.axis('off')\n",
    "    \n",
    "    plt.title(\"Master 2 Decision System - Full C4.5 Tree\", \n",
    "              color='white', fontsize=18, fontweight='bold', pad=20)\n",
    "    \n",
    "    # Calculate positions for nodes\n",
    "    positions = {}\n",
    "    \n",
    "    def calculate_positions(node, x, y, dx):\n",
    "        if node is None:\n",
    "            return\n",
    "        \n",
    "        positions[id(node)] = (x, y)\n",
    "        \n",
    "        if not node.is_leaf():\n",
    "            calculate_positions(node.left, x - dx, y - 1, dx / 2)\n",
    "            calculate_positions(node.right, x + dx, y - 1, dx / 2)\n",
    "    \n",
    "    calculate_positions(tree_root, 0.5, 1, 0.25)\n",
    "    \n",
    "    # Draw edges\n",
    "    def draw_edges(node):\n",
    "        if node is None or node.is_leaf():\n",
    "            return\n",
    "        \n",
    "        x, y = positions[id(node)]\n",
    "        \n",
    "        if node.left:\n",
    "            x_left, y_left = positions[id(node.left)]\n",
    "            ax.plot([x, x_left], [y - 0.05, y_left + 0.05], color='#4DA6FF', linewidth=1.5, alpha=0.6)\n",
    "            ax.text((x + x_left) / 2, (y + y_left) / 2, \"Yes\", fontsize=8, color='#4DA6FF', ha='center')\n",
    "            draw_edges(node.left)\n",
    "        \n",
    "        if node.right:\n",
    "            x_right, y_right = positions[id(node.right)]\n",
    "            ax.plot([x, x_right], [y - 0.05, y_right + 0.05], color='#FF6B6B', linewidth=1.5, alpha=0.6)\n",
    "            ax.text((x + x_right) / 2, (y + y_right) / 2, \"No\", fontsize=8, color='#FF6B6B', ha='center')\n",
    "            draw_edges(node.right)\n",
    "    \n",
    "    draw_edges(tree_root)\n",
    "    \n",
    "    # Draw nodes\n",
    "    def draw_nodes(node):\n",
    "        if node is None:\n",
    "            return\n",
    "        \n",
    "        x, y = positions[id(node)]\n",
    "        \n",
    "        if node.is_leaf():\n",
